{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hyperbrowser Extensions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Extensions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add a New Extension",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.hyperbrowser.ai/api/extensions/add",
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Add a New Extension"
        },
        {
          "info": {
            "name": "List All Extensions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hyperbrowser.ai/api/extensions/list",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "List All Extensions"
        }
      ]
    }
  ],
  "bundled": true
}